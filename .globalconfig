# Global analyser configuration. The SDK discovers this file from the directories above each
# project's sources and applies it to every compilation, independent of the file a diagnostic is
# reported in.
#
# RS0016 (public API not in the baseline) and RS0017 (baseline entry with no matching API) are
# errors in their own right rather than warnings promoted by TreatWarningsAsErrors (PLO-788). The
# SonarScanner for .NET build step in build-dotnet.yml sets TreatWarningsAsErrors=false and clears
# WarningsAsErrors (SonarQube.Integration.targets, "OverrideRoslynCodeAnalysisProperties"), so a
# warning-level rule would let baseline drift through CI (PLO-823). A .editorconfig section cannot
# do this for RS0017, which is reported inside PublicAPI.Unshipped.txt rather than in a source file;
# only a global config reaches it.
is_global = true

dotnet_diagnostic.RS0016.severity = error
dotnet_diagnostic.RS0017.severity = error

# The remaining baseline-integrity and API-design rules of the same analyser, for the same reason:
# a warning would pass the scanner-wrapped CI build. None fires today. RS0026/RS0027 are lowered to
# a suggestion for src/Spectre/CommandLine.Spectre/Output alone in .editorconfig, which takes
# precedence over this file for the files it matches (PLO-822).
dotnet_diagnostic.RS0022.severity = error
dotnet_diagnostic.RS0024.severity = error
dotnet_diagnostic.RS0025.severity = error
dotnet_diagnostic.RS0026.severity = error
dotnet_diagnostic.RS0027.severity = error
dotnet_diagnostic.RS0036.severity = error
dotnet_diagnostic.RS0037.severity = error
dotnet_diagnostic.RS0041.severity = error
dotnet_diagnostic.RS0048.severity = error
dotnet_diagnostic.RS0050.severity = error
