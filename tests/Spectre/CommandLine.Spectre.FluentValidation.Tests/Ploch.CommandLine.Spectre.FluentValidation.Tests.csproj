<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Ploch sibling dependencies. See UsePlochProjectReferences in Directory.Build.props. -->
  <ItemGroup Condition="'$(UsePlochProjectReferences)' != 'true'">
    <PackageReference Include="Ploch.TestingSupport.XUnit3.AutoMoq" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePlochProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\..\ploch-common\src\TestingSupport.XUnit3.AutoMoq\Ploch.TestingSupport.XUnit3.AutoMoq.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Spectre\CommandLine.Spectre.FluentValidation\Ploch.CommandLine.Spectre.FluentValidation.csproj" />
  </ItemGroup>

</Project>
