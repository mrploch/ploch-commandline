<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!-- Clear inherited sources (including any machine-global feeds) so Central Package
             Management sees a deterministic, fully-mapped source list and does not emit NU1507. -->
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="github" value="https://nuget.pkg.github.com/mrploch/index.json" />
    </packageSources>
    <!--
         CPM requires every source to be mapped.

         Ploch.* is listed under BOTH sources deliberately. Source mapping is longest-prefix-wins
         and *exclusive*: with Ploch.* mapped only to github, the more specific pattern won and
         nuget.org was never consulted for a Ploch package ("Versions from nuget.org were not
         considered", NU1103). GitHub Packages only ever holds CI prerelease builds, so the
         stable ploch-common 4.x release on nuget.org was unreachable and this repository could
         not consume a stable Ploch dependency at all (issues #46, #47).

         Listing the pattern under both makes both feeds eligible and NuGet resolves the best
         match across them: stable releases from nuget.org, prerelease CI builds from
         GitHub Packages when a version range asks for one.

         One consequence worth stating, raised by the Antigravity reviewer on PR #52: a
         wildcard pattern pointed at a public feed is the shape of a dependency-confusion
         risk. If a Ploch.* package ever existed ONLY on GitHub Packages, someone could
         publish that id on nuget.org and this mapping would happily consider it. That is
         not the case today - every Ploch.* package this repository consumes is published on
         nuget.org, and the family is open source - so the wildcard is accurate rather than
         permissive. If a genuinely private Ploch.* package is ever introduced, narrow the
         nuget.org side to explicit package ids instead of the prefix.
    -->
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
            <package pattern="Ploch.*" />
        </packageSource>
        <packageSource key="github">
            <package pattern="Ploch.*" />
        </packageSource>
    </packageSourceMapping>
    <!--
         %GH_PACKAGES_TOKEN% is OPTIONAL for building this repository, and is deliberately kept
         that way. It is empty for pull requests opened from a fork (GitHub withholds repository
         secrets from those runs) and unset for any contributor who has not created a token, so
         an unauthenticated restore has to remain a working restore.

         It still is one today only because every Ploch.* version `main` references is a stable
         release on nuget.org: the github feed answers 401, NuGet warns, retries, and falls back
         to nuget.org. Verified 2026-09-21 with the variable unset and an empty packages folder -
         exit code 0. Reference a PRERELEASE Ploch version and that stops being true, because
         prereleases exist on GitHub Packages alone: restore then fails with
         `error NU1301 ... 401 (Unauthorized)`.

         That is why the stable-only policy in Directory.Packages.props exists and is enforced by
         VerifyPlochPackageVersionsAreStable (Directory.Build.props). See CONTRIBUTING.md and
         issue #54.
    -->
    <packageSourceCredentials>
        <github>
            <add key="Username" value="kploch" />
            <add key="ClearTextPassword" value="%GH_PACKAGES_TOKEN%" />
        </github>
    </packageSourceCredentials>
    <disabledPackageSources />
</configuration>
