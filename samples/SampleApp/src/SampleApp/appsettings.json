{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "SampleAppSettings": {
    "Environment": "Development",
    "DefaultOutputDirectory": "./output",
    "MaxBatchSize": 100,
    "EnableDiagnostics": true
  }
}
