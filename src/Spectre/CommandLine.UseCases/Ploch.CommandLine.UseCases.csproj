<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Use-case abstractions (IUseCase, IResultUseCase) and a base Spectre.Console.Cli command that runs a use case and renders its Ardalis.Result.</Description>
    <PackageTags>$(PackageTags);use-cases;ardalis-result</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommandLine.Spectre\Ploch.CommandLine.Spectre.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
