<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>FluentValidation integration for Ploch.CommandLine.Spectre: validates command settings with FluentValidation validators before a command runs.</Description>
    <PackageTags>$(PackageTags);fluentvalidation;validation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <!-- Ploch sibling dependencies. See UsePlochProjectReferences in Directory.Build.props. -->
  <ItemGroup Condition="'$(UsePlochProjectReferences)' != 'true'">
    <PackageReference Include="Ploch.Common.DependencyInjection" />
    <PackageReference Include="Ploch.Common" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePlochProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\..\ploch-common\src\Common.DependencyInjection\Ploch.Common.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\..\..\ploch-common\src\Common\Ploch.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommandLine.Spectre\Ploch.CommandLine.Spectre.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
