<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Authors>Kris Ploch</Authors>
    <Company>Ploch</Company>
    <Product>Ploch.CommandLine</Product>
    <PackageProjectUrl>https://github.com/mrploch/ploch-commandline</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mrploch/ploch-commandline.git</RepositoryUrl>
    <Description>Build advanced console apps with ease.</Description>
    <Copyright>Kris Ploch $([System.DateTime]::Now.Year)</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <!--
      The repository builds clean, so the zero-warning bar is enforced rather than merely met:
      without this a new warning lands silently and the bar erodes one commit at a time.
      Low and moderate NuGet audit advisories (NU1901, NU1902) are exempt. They fire when an
      advisory is published against a dependency that has not changed, so without the exemption
      a minor advisory turns into a red build on an untouched branch. High and critical
      advisories (NU1903, NU1904) stay fatal on purpose: those should stop a release rather
      than wait for somebody to notice warning output.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902</WarningsNotAsErrors>
    <!-- Versioning is handled by Nerdbank.GitVersioning (version.json). -->
    <!-- SourceLink: lets consumers step into this repository's sources when debugging. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Deterministic builds for CI. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsTestProject>$(MSBuildProjectName.EndsWith('Tests'))</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Label="ProjectType">
    <IsReleaseBuild>false</IsReleaseBuild>
    <IsReleaseBuild Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">true</IsReleaseBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <!--
      Portable rather than embedded: an embedded PDB cannot be lifted into a
      standalone .snupkg symbol package, so embedding would silently produce
      empty symbol packages for the published NuGet packages.
    -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="$(IsTestProject)">
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <PropertyGroup Condition="!$(IsTestProject)">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <Target Name="PrintSettings" BeforeTargets="Build">
    <Message Text="Building $(MSBuildProjectName) with settings:" Importance="high" />
    <Message Text="MSBuildProjectName -> '$(MSBuildProjectName)'" Importance="high" />
    <Message Text="Configuration -> '$(Configuration)' " Importance="high" />
    <Message Text="DebugType -> '$(DebugType)' " Importance="high" />
    <Message Text="DebugSymbols -> '$(DebugSymbols)' " Importance="high" />
    <Message Text="AssemblyName -> '$(AssemblyName)' " Importance="high" />
    <Message Text="IsTestProject -> '$(IsTestProject)' " Importance="high" />
    <Message Text="GeneratePackageOnBuild -> '$(GeneratePackageOnBuild)' " Importance="high" />
    <Message Text="GenerateDocumentationFile -> '$(GenerateDocumentationFile)' " Importance="high" />
    <Message Text="IsPackable -> '$(IsPackable)' " Importance="high" />
  </Target>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
  </PropertyGroup>

  <!--
    How this repository consumes the sibling Ploch repositories (ploch-common).

    Default (false): PackageReference against the released packages on nuget.org, versioned
    centrally from mrploch-development/dependencies/Ploch.Packages.props. This is what CI and
    the release build use, and it is the only mode that produces a correct package at pack
    time - a cross-repo ProjectReference becomes a NuGet *dependency* whose version comes from
    whatever the sibling checkout happens to be, which is how a stable Ploch.CommandLine.Spectre
    would otherwise have shipped depending on a prerelease Ploch.Common (issue #47, NU5104).
    It also removes the requirement for a sibling checkout to exist at all.

    Opt in with -p:UsePlochProjectReferences=true to build against a local ploch-common
    checkout instead - for cross-repo development, where a change in ploch-common needs to be
    seen here before it is published. Note the local checkout may be ahead of the released
    packages (ploch-common main is on 4.1-prerelease), so the two modes are not interchangeable.

    CI only exercises the DEFAULT (package) mode for the main solution. The one
    -p:UsePlochProjectReferences=true invocation in build-dotnet.yml builds the *sample*
    solution and does not run the main test projects against the sibling dependency graph, so
    project-reference mode is verified locally but not guarded by CI. Raised by the Codex
    reviewer on PR #52; adding a second CI job for it is tracked in #51.
  -->
  <PropertyGroup>
    <UsePlochProjectReferences Condition="'$(UsePlochProjectReferences)' == ''">false</UsePlochProjectReferences>
  </PropertyGroup>

  <!--
    Stable-only Ploch dependency policy - enforcement. See CONTRIBUTING.md ("Ploch dependencies
    are always stable") for the policy itself and Directory.Packages.props for where the
    versions come from. Issue #54 / PLO-523.

    In short: the MAIN solution must never resolve a PRERELEASE Ploch.* version. Prereleases are
    published to GitHub Packages only, that feed needs %GH_PACKAGES_TOKEN%, and GitHub withholds
    repository secrets from pull requests opened from forks - so a prerelease version turns
    every fork pull request, and every tokenless local build, into a hard
    `error NU1301 ... 401 (Unauthorized)` that names a secret the contributor cannot be given -
    measured 2026-09-20 (UTC). The same prerelease would also make the release build pack a
    stable package with a prerelease dependency, which is the #47 / NU5104 defect.

    SCOPE. This target validates the central package versions of the solution it is invoked on,
    which is the whole of the policy's reach. samples/SampleApp is a separate, deliberately
    standalone central-package root that this file never reaches, and it pins a PRERELEASE
    Ploch.CommandLine.* build on purpose (see the comment on $(PlochPackagesVersion) in
    samples/SampleApp/Directory.Packages.props): those are this repository's own CI builds of
    its own packages, not ploch-common dependencies, and the sample is built in CI with
    -p:UsePlochProjectReferences=true, which removes them entirely. Widening the target over
    that root would report a violation of a rule that does not apply to it. Raised by the Codex
    and Copilot reviewers on PR #85.

    This target is the guard. It is NOT hooked to Build or Restore: it costs nothing until it
    is named explicitly, so no developer build gets slower and no environment-dependent
    behaviour is introduced. build-dotnet.yml and release.yml run it once, before restore. Run
    it yourself with:

      dotnet msbuild src/Spectre/CommandLine.Spectre/Ploch.CommandLine.Spectre.csproj -t:VerifyPlochPackageVersionsAreStable

    It deliberately inspects the resolved PackageVersion items rather than the shared
    $(PlochCommonPackagesVersion) / $(PlochDataPackagesVersion) properties, so it still fires
    for a version pinned by any other route. The remaining route around a central version -
    a per-project VersionOverride - is closed in Directory.Packages.props by setting
    CentralPackageVersionOverrideEnabled=false, which is a build error rather than something
    this target could see from one project. Raised by the Copilot reviewer on PR #85.

    Package ids are compared case-insensitively because NuGet ids are case-insensitive: a
    prerelease `ploch.common` would otherwise slip past a case-sensitive prefix test. Raised by
    the Codacy and CodeRabbit reviewers on PR #85.
  -->
  <Target Name="VerifyPlochPackageVersionsAreStable">
    <ItemGroup>
      <PrereleasePlochPackageVersion Include="@(PackageVersion)"
                                     Condition="$([MSBuild]::ValueOrDefault('%(Identity)', '').ToUpperInvariant().StartsWith('PLOCH.')) AND $([MSBuild]::ValueOrDefault('%(Version)', '').Contains('-'))" />
    </ItemGroup>
    <Error Condition="'@(PrereleasePlochPackageVersion)' != ''"
           Code="PLOCH0001"
           Text="Prerelease Ploch package version(s) referenced: @(PrereleasePlochPackageVersion->'%(Identity) %(Version)', '; '). The main solution must only reference STABLE Ploch versions - prereleases live on GitHub Packages, which fork pull requests cannot authenticate against (issue #54). Fix the version in mrploch-development/dependencies/Ploch.Packages.props, or, if you genuinely need the unreleased sources, build locally with -p:UsePlochProjectReferences=true instead of pinning a prerelease." />
    <Message Condition="'@(PrereleasePlochPackageVersion)' == ''"
             Importance="high"
             Text="Every Ploch.* central package version reachable from $(MSBuildProjectName) is stable." />
  </Target>

  <!-- Nerdbank.GitVersioning for all projects. SourceLink needs no package reference: the .NET 8+ SDK
       includes it and reads the PublishRepositoryUrl / EmbedUntrackedSources settings above. -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Inject Coverlet's MSBuild instrumentation into every test project so
    `dotnet test -p:CollectCoverage=true` produces cobertura + opencover reports.
    Without this the CI coverage flag is a silent no-op and the Codacy coverage
    step in build-dotnet.yml finds no report to upload. See issue #13.
  -->
  <PropertyGroup Condition="$(IsTestProject)">
    <!--
      Measure only this repository's assemblies. Without this the report is
      dominated by referenced sibling repos (Ploch.Common et al.) and the
      resulting percentage describes someone else's code.
    -->
    <Include>[Ploch.CommandLine.*]*</Include>
    <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
  </PropertyGroup>
  <ItemGroup Condition="$(IsTestProject)">
    <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Test harness, declared here so every test project owns the runner it needs.

    These used to arrive transitively: a ProjectReference propagates the referenced project's
    entire PackageReference closure, so the test projects free-rode on the harness of the
    sibling Ploch.TestingSupport.XUnit3.* projects. A PackageReference does not work that way -
    only what the .nuspec declares flows - and the published
    Ploch.TestingSupport.XUnit3.Dependencies package declares Microsoft.NET.Test.Sdk with
    exclude="Build,Analyzers" (which strips the MSBuild targets that register the test host)
    and does not declare xunit.runner.visualstudio at all. The result after the switch to
    packages was a clean build in which `dotnet test` discovered nothing: "No test is available
    ... Make sure that test discoverer & executors are registered".

    A test project should declare its own runner regardless of where its assertions come from,
    so this is the correct home for it rather than a transitive accident.
  -->
  <ItemGroup Condition="$(IsTestProject)">
    <!--
      PrivateAssets on the runner infrastructure but not on xunit.v3, matching the dotnet SDK
      test template: the host and the VSTest adapter are build-time infrastructure, whereas
      xunit.v3 is a real reference the test code compiles against. Currently cosmetic - test
      projects are IsPackable=false so nothing flows anywhere - but the template shape is the
      one a reader expects. Raised by the Copilot (Grok 4.6) reviewer on PR #52.
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
</Project>
